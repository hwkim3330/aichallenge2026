<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="use_sim_time" default="true"/>
  <arg name="vscan_mode" default="false"/>
  <arg name="ckpt_path" default="$(find-pkg-share tiny_lidar_net_controller)/ckpt/tinylidarnet_weights.npy"/>
  <arg name="model_type" default="tiny_lidar_net"/>
  <arg name="csv_path" default="$(find-pkg-share laserscan_generator)/map/lane.csv"/>
  <!-- Route through nominal_control_cmd, not control_cmd, so stuck_recovery_controller
       sits between the network and the vehicle exactly as it does for the MPC.
       This node is launched unconditionally in reference.launch.xml but subscribes to
       nominal_control_cmd, so publishing straight to control_cmd left it with no input at
       all: inert, never detecting, never rescuing. The AI track was running with no
       deadlock safety net while the same net took the MPC track from 32 laps to 68 across
       12 races (tools/GOAL.md). -->
  <!-- nominal_control_cmd, NOT control_cmd, and that is required in THIS tree rather than a
       preference. Upstream publishes straight to control_cmd because upstream has neither
       lidar_guard nor stuck_recovery_controller; we added both, and they sit in the AI chain as
       TLN then guard then recovery then control_cmd. Publishing directly to control_cmd starves
       them, and the car never reports ready: measured as "no car reported ready inside 90 s" with
       an 81 line log ending at node startup. To run the genuinely official path, those two nodes
       have to leave the chain, which is a launch change and not an environment variable. -->
  <arg name="control_cmd_topic" default="/control/command/nominal_control_cmd"/>

  <group if="$(var vscan_mode)">
    <include file="$(find-pkg-share laserscan_generator)/launch/laserscan_generator.launch.xml">
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="csv_path" value="$(var csv_path)"/>
    </include>
  </group>

  <include file="$(find-pkg-share tiny_lidar_net_controller)/launch/tiny_lidar_net.launch.xml">
    <arg name="ckpt_path" value="$(var ckpt_path)"/>
    <arg name="model_type" value="$(var model_type)"/>
    <arg name="control_cmd_topic" value="$(var control_cmd_topic)"/>
  </include>
</launch>
