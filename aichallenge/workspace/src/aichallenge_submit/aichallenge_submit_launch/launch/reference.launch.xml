<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!-- Essential parameters -->
  <arg name="vehicle_id" default="$(env VEHICLE_ID default)" description="vehicle specific ID"/>
  <arg name="simulation" description="used for sensor kit param"/>
  <arg name="use_sim_time"/>
  <arg name="map_path" default="$(find-pkg-share aichallenge_submit_launch)/map"/>
  <arg name="vehicle_model" default="racing_kart"  description="vehicle model name"/>
  <arg name="sensor_model" default="racing_kart_sensor_kit" description="sensor model name"/>
  <!-- Optional parameters -->
  <!-- Track selection: kashiwanoha assets live in a <track>/ subdir; citycircuit uses the package default paths.
       Switch tracks by editing this default (and match it with the simulator's venue arg); pass track:= to override. -->
  <arg name="track" default="citycircuit" description="track preset: citycircuit, kashiwanoha"/>
  <arg name="track_subdir" default="$(eval &quot;'' if '$(var track)' == 'citycircuit' else '$(var track)/'&quot;)"/>
  <!-- Map -->
  <arg name="lanelet2_map_file" default="$(var track_subdir)lanelet2_map.osm" description="lanelet2 map file name"/>
  <arg name="pointcloud_map_file" default="pointcloud_map.pcd" description="pointcloud map file name"/>

  <!-- Vehicle -->
  <arg name="launch_vehicle_interface" default="$(eval &quot;'$(var simulation)' == 'false'&quot;)"/>
  <log message="echo launch param use_sim_time: $(var use_sim_time) launch_vehicle_interface: $(var launch_vehicle_interface) sensor_model: $(var sensor_model)"/>

  <!-- Control method -->
  <arg name="control_method" default="mpc"
      description="Select control: mpc, pure_pursuit, tiny_lidar_net, pilot_net, joycon, rl_train"/>
  <!-- Overrides the track-derived config file name, so one image can serve
       several vehicles with different MPC tuning (set MPC_CONFIG_FILE per
       container). Empty keeps the track default. -->
  <arg name="mpc_config_file" default=""/>
  <!-- The provider is only needed when the MPC is told to take constraints from a
       topic. With reference_path.use_path_constraints_topic false the MPC computes
       them itself each cycle from its ACTUAL pose (MPC.py:245), which needs no
       provider, no 2 s staleness and no synthetic pose. Default off. -->
  <arg name="use_path_constraints_provider" default="false"/>
  <arg name="guard_front_limit" default="1.25"/>
  <arg name="guard_side_limit" default="0.72"/>
  <arg name="guard_speed" default="5.5"/>
  <arg name="mpc_ref_vel_file" default=""/>
  <!-- Gates ALL other-vehicle awareness in mpc_controller: the V2X tracker, the
       path_constraints subscription and the wait for it. config.yaml's
       use_path_constraints_topic is dead unless this is true, which is worth knowing
       because that flag reads as if overtaking were enabled and it is not.
       Left OFF deliberately. Turning it on does not produce overtaking: the MPC
       treats the other car as an obstacle and gives up speed to queue behind it, so
       the lap gets slower with nothing gained. The archived submissions show the same
       conclusion being reached before (obstacle_avoid_r0.65 followed by
       avoidance_off_recovery).
       The consequence is accepted rather than solved: with no obstacle awareness the
       car will drive into one ahead, and rear-ending carries a penalty that stops the
       car. The answer to that is to lead from the start, and to rely on
       stuck_recovery_controller when contact happens anyway. -->
  <arg name="use_obstacle_avoidance" default="false"/>
  <arg name="use_boost_acceleration" default="false"/>

  <!-- Global parameters -->
  <group scoped="false">
    <include file="$(find-pkg-share global_parameter_loader)/launch/global_params.launch.py">
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="vehicle_model" value="$(var vehicle_model)"/>
    </include>
  </group>

  <group>
    <arg name="model_file" default="$(find-pkg-share tier4_vehicle_launch)/urdf/vehicle.xacro" description="path to the file of model settings (*.xacro)"/>
    <arg name="config_dir" default="$(find-pkg-share racing_kart_sensor_kit_description)/config"/>
    <node name="robot_state_publisher" pkg="robot_state_publisher" exec="robot_state_publisher">
      <param name="robot_description" value="$(command 'xacro $(var model_file) vehicle_model:=$(var vehicle_model) sensor_model:=$(var sensor_model) config_dir:=$(var config_dir) simulation:=$(var simulation)' 'warn')"/>
    </node>
  </group>

  <!-- Sensing -->
  <group>
    <push-ros-namespace namespace="sensing"/>
    <!-- Vehicle Velocity Converter  -->
    <include file="$(find-pkg-share vehicle_velocity_converter)/launch/vehicle_velocity_converter.launch.xml">
      <arg name="input_vehicle_velocity_topic" value="/vehicle/status/velocity_status"/>
      <arg name="output_twist_with_covariance" value="/sensing/vehicle_velocity_converter/twist_with_covariance"/>
      <arg name="config_file" value="$(find-pkg-share aichallenge_submit_launch)/config/vehicle_velocity_converter.param.yaml"/>
    </include>
    <group>
      <push-ros-namespace namespace="imu"/>
      <arg name="imu_corrector_param_file" default="$(find-pkg-share imu_corrector)/config/imu_corrector.param.yaml"/>
      <include file="$(find-pkg-share imu_corrector)/launch/imu_corrector.launch.xml">
        <arg name="input_topic" value="imu_raw"/>
        <arg name="output_topic" value="imu_data"/>
        <arg name="param_file" value="$(var imu_corrector_param_file)"/>
      </include>
    </group>
    <group>
      <push-ros-namespace namespace="gnss"/>
      <include file="$(find-pkg-share racing_kart_gnss_poser)/launch/gnss_poser.launch.xml">
        <arg name="input_topic_fix" value="nav_sat_fix"/>
        <arg name="output_topic_gnss_pose" value="pose"/>
        <arg name="output_topic_gnss_fixed" value="gnss_fixed"/>
        <arg name="output_topic_gnss_pose_cov" value="pose_with_covariance"/>
      </include>
    </group>
  </group>

    <!-- Localization -->
  <let name="pose_additional_delay_var" value="0.0" />
  <group>
    <push-ros-namespace namespace="localization"/>
    <include file="$(find-pkg-share gyro_odometer)/launch/gyro_odometer.launch.xml">
      <arg name="input_vehicle_twist_with_covariance_topic" value="/sensing/vehicle_velocity_converter/twist_with_covariance"/>
      <arg name="input_imu_topic" value="/sensing/imu/imu_data"/>
      <arg name="output_twist_with_covariance_topic" value="/localization/twist_estimator/twist_with_covariance"/>
      <arg name="output_twist_with_covariance_raw_topic" value="/localization/twist_estimator/twist_with_covariance_raw"/>
    </include>

    <node pkg="imu_gnss_poser" exec="imu_gnss_poser_node" name="imu_gnss_poser" output="screen">
      <param from="$(find-pkg-share imu_gnss_poser)/config/imu_gnss_poser.param.yaml"/>
      <param name="heading_csv_path" value="$(find-pkg-share imu_gnss_poser)/data/$(var track_subdir)heading_reference.csv"/>
    </node>

    <include file="$(find-pkg-share ekf_localizer)/launch/ekf_localizer.launch.xml">
      <arg name="enable_yaw_bias_estimation" value="false"/>
      <arg name="tf_rate" value="30.0"/>
      <arg name="twist_smoothing_steps" value="1"/>
      <arg name="pose_smoothing_steps" value="1"/>
      <arg name="input_initial_pose_name" value="/localization/initial_pose3d"/>
      <arg name="input_pose_with_cov_name" value="/localization/imu_gnss_poser/pose_with_covariance"/>
      <arg name="input_twist_with_cov_name" value="/localization/twist_estimator/twist_with_covariance"/>
      <arg name="output_odom_name" value="kinematic_state"/>
      <arg name="output_pose_name" value="pose"/>
      <arg name="output_pose_with_covariance_name" value="/localization/pose_with_covariance"/>
      <arg name="output_biased_pose_name" value="biased_pose"/>
      <arg name="output_biased_pose_with_covariance_name" value="biased_pose_with_covariance"/>
      <arg name="output_twist_name" value="twist"/>
      <arg name="output_twist_with_covariance_name" value="twist_with_covariance"/>
      <arg name="proc_stddev_vx_c" value="10.0"/>
      <arg name="proc_stddev_wz_c" value="5.0"/>
      <arg name="pose_additional_delay" value="$(var pose_additional_delay_var)"/>
      <arg name="extend_state_step" value="100"/>
    </include>

    <!-- twist2accel -->
    <group>
      <node pkg="twist2accel" exec="twist2accel" name="twist2accel" output="screen">
        <param name="accel_lowpass_gain" value="0.9"/>
        <param name="use_odom" value="true"/>
        <remap from="input/odom" to="/localization/kinematic_state"/>
        <remap from="input/twist" to="/localization/twist_estimator/twist_with_covariance"/>
        <remap from="output/accel" to="/localization/acceleration"/>
      </node>
    </group>

  </group>

  <!-- Planning -->
  <group>
    <push-ros-namespace namespace="planning"/>

    <!-- scenario_planning -->
    <group>
      <push-ros-namespace namespace="scenario_planning"/>

      <!-- Customizable -->
      <node pkg="simple_trajectory_generator" exec="simple_trajectory_generator_node" name="simple_trajectory_generator" output="screen">
            <param name="csv_path" value="$(find-pkg-share simple_trajectory_generator)/data/$(var track_subdir)raceline_awsim_30km_from_garage.csv"/>
            <param name="z" value="6.5"/>
      </node>
      
    </group>
  </group>

  <!-- Control -->
  <group if="$(eval &quot;'$(var control_method)' == 'pure_pursuit'&quot;)">
    <include file="$(find-pkg-share aichallenge_submit_launch)/launch/control/pure_pursuit.launch.xml">
      <arg name="simulation" value="$(var simulation)"/>
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
    </include>
  </group>

  <group if="$(eval &quot;'$(var control_method)' == 'mpc'&quot;)">
    <include file="$(find-pkg-share aichallenge_submit_launch)/launch/control/mpc.launch.xml">
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="track" value="$(var track)"/>
      <arg name="mpc_config_file" value="$(var mpc_config_file)"/>
      <arg name="mpc_ref_vel_file" value="$(var mpc_ref_vel_file)"/>
      <arg name="use_boost_acceleration" value="$(var use_boost_acceleration)"/>
      <arg name="use_obstacle_avoidance" value="$(var use_obstacle_avoidance)"/>
      <arg name="output_control_cmd" value="/control/command/mpc_cmd"/>
    </include>

    <!-- The node that turns obstacles into the path constraints the MPC subscribes
         to. Nothing launched it before 2026-08-02, and nothing publishes
         /aichallenge/objects either, so the obstacle set was permanently empty and
         use_obstacle_avoidance changed nothing at all. That is why enabling it once
         measured as "identical to off, no performance cost". Gated on the same flag
         rather than a new one, so that flag finally means something.

         It rebuilds its own Map, ReferencePath, car and MPC and republishes
         constraints for every waypoint at 0.5 Hz, so it is not cheap, and a 2 s
         update is coarse for a moving obstacle. Note it hardcodes config.yaml and
         ignores mpc_config_file, so a per-vehicle MPC config will not reach it. -->
    <group if="$(var use_path_constraints_provider)">
      <include file="$(find-pkg-share multi_purpose_mpc_ros)/launch/path_constraints_provider.launch.py">
        <arg name="use_sim_time" value="$(var use_sim_time)"/>
      </include>
    </group>

    <!-- LiDAR safety layer, between the MPC and the recovery node.
         Measured 2026-07-30: with one Autoware car and one AWSIM NPC on track,
         /v2x/vehicle_positions carried ZERO messages in 12 s while
         /sensing/lidar/scan carried 241 at 750 beams. Our MPC sees rivals only
         through v2x (reference_path.use_path_constraints_topic), so the NPC that
         every scored battle includes (lapping in ~149 s per the board's own
         records) is invisible to us. LiDAR is the only sensor that sees it.
         The official 3-vehicle config runs lidar on (RaceConfig/eval-3p.yaml).
         Always in the chain: with no scan it is an exact passthrough (it publishes
         on command arrival, not on a timer, so it adds no latency and never
         republishes a stale command). A/B it by turning the simulator's LiDAR on
         or off rather than by rewiring.
         Ahead of the recovery node on purpose: a guard that brakes for the wall
         it is being reversed away from would fight the recovery manoeuvre. -->
    <node pkg="tiny_lidar_net_controller" exec="lidar_guard.py"
          name="lidar_guard" output="screen">
      <param name="use_sim_time" value="$(var use_sim_time)"/>
      <param name="front_limit" value="$(var guard_front_limit)"/>
      <param name="side_limit" value="$(var guard_side_limit)"/>
      <param name="guard_speed" value="$(var guard_speed)"/>
      <remap from="/control/command/control_cmd"
             to="/control/command/nominal_control_cmd"/>
    </node>

    <!-- Sits between the MPC and the vehicle: passes nominal_control_cmd straight
         through to control_cmd, and takes over with a reverse then drive manoeuvre
         when the car is commanded to move but is not moving.
         This matters specifically for evaluation. aichallenge/simulator_scripts/
         eval.sh starts the simulator with wall recovery OFF, so a wall contact is
         not undone for us: the car stays where it stopped and the run ends with
         whatever laps it had. Measured today, a bad corner speed left the vehicle
         stationary 62 m in, at full steering lock (0.93 rad) and full commanded
         acceleration, for the rest of the session.
         The package was already in aichallenge_submit but nothing launched it. -->
    <node pkg="stuck_recovery_controller" exec="stuck_recovery_controller_node"
          name="stuck_recovery_controller" output="screen">
      <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>
  </group>

  <group if="$(eval &quot;'$(var control_method)' == 'tiny_lidar_net'&quot;)">
    <include file="$(find-pkg-share aichallenge_submit_launch)/launch/control/tiny_lidar_net.launch.xml">
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
    </include>
  </group>

  <group if="$(eval &quot;'$(var control_method)' == 'pilot_net'&quot;)">
    <include file="$(find-pkg-share aichallenge_submit_launch)/launch/control/pilot_net.launch.xml">
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
    </include>
  </group>

  <group if="$(eval &quot;'$(var control_method)' == 'joycon'&quot;)">
    <include file="$(find-pkg-share aichallenge_submit_launch)/launch/control/joycon.launch.xml"/>
  </group>

  <group if="$(eval &quot;'$(var control_method)' == 'rl_train'&quot;)">
    <include file="$(find-pkg-share aichallenge_submit_launch)/launch/control/rl_train.launch.xml"/>
  </group>

  <!-- Map -->
  <group>
    <push-ros-namespace namespace="map"/>

    <!-- map_container -->
    <node_container pkg="rclcpp_components" exec="component_container" name="map_container" namespace="">

      <!-- map_loader::Lanelet2MapLoaderNode -->
      <composable_node pkg="map_loader" plugin="Lanelet2MapLoaderNode" name="lanelet2_map_loader" namespace="">
        <remap from="output/lanelet2_map" to="vector_map" />
        <param name="lanelet2_map_path" value="$(var map_path)/$(var lanelet2_map_file)" />
        <param from="$(find-pkg-share aichallenge_submit_launch)/config/map/lanelet2_map_loader.param.yaml" />
        <extra_arg name="use_intra_process_comms" value="false" />
      </composable_node>

      <!-- map_loader::Lanelet2MapVisualizationNode -->
      <composable_node pkg="map_loader" plugin="Lanelet2MapVisualizationNode" name="lanelet2_map_visualization" namespace="">
        <remap from="input/lanelet2_map" to="vector_map" />
        <remap from="output/lanelet2_map_marker" to="vector_map_marker" />
        <param name="lanelet2_map_path" value="$(var map_path)/$(var lanelet2_map_file)" />
        <param from="$(find-pkg-share aichallenge_submit_launch)/config/map/lanelet2_map_loader.param.yaml" />
        <extra_arg name="use_intra_process_comms" value="false" />
      </composable_node>

      <!-- map_tf_generator::VectorMapTFGeneratorNode -->
      <composable_node pkg="map_tf_generator" plugin="VectorMapTFGeneratorNode" name="vector_map_tf_generator" namespace="">
        <param name="map_frame" value="map" />
        <param name="viewer_frame" value="viewer" />
        <extra_arg name="use_intra_process_comms" value="false" />
      </composable_node>

    </node_container>

  </group> <!-- map -->

  <!-- vehicle -->
  <group if="$(var launch_vehicle_interface)">
    <include file="$(find-pkg-share raw_vehicle_cmd_converter)/launch/raw_vehicle_converter.launch.xml">
      <arg name="converter_param_path" value="$(find-pkg-share aichallenge_submit_launch)/config/converter.param.yaml"/>
      <arg name="csv_path_accel_map" value="$(find-pkg-share aichallenge_submit_launch)/data/accel_map.csv"/>
      <arg name="csv_path_brake_map" value="$(find-pkg-share aichallenge_submit_launch)/data/brake_map.csv"/>

      <arg name="max_throttle" value="1.0"/>
      <arg name="max_brake" value="1.0"/>
      <arg name="convert_accel_cmd" value="true"/>
      <arg name="convert_brake_cmd" value="true"/>
      <arg name="convert_steer_cmd" value="false"/>

      <arg name="input_control_cmd" value="/control/command/control_cmd"/>
      <arg name="input_odometry" value="/localization/kinematic_state"/>
      <arg name="input_steering" value="/vehicle/status/steering_status"/>
      <arg name="output_actuation_cmd" value="/control/command/actuation_cmd"/>
    </include>
  </group>

</launch>
